{
  "info": {
    "name": "CS Cinemas API",
    "description": "API collection for CS Cinemas backend server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"8147897771\",\n  \"password\": \"Test@1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Test@1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"8147897771\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp"
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Theaters",
      "item": [
        {
          "name": "Get Theaters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/theaters"
          }
        },
        {
          "name": "Get Theater Availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/theaters/:id/availability?date=2026-09-15"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/bookings/check-availability?theaterId=THEATER_ID&date=2026-09-15"
          }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"theaterId\": \"THEATER_ID\",\n  \"date\": \"2026-09-15\",\n  \"timeSlot\": \"2:00 PM - 5:00 PM\",\n  \"eventTypeId\": \"EVENT_TYPE_ID\",\n  \"customerDetails\": {\n    \"name\": \"John Doe\",\n    \"phone\": \"8147897771\",\n    \"email\": \"john@example.com\"\n  }\n}"
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "My Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/bookings/my"
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"BOOKING_ID\"\n}"
            },
            "url": "{{baseUrl}}/payment/create-order"
          }
        }
      ]
    },
    {
      "name": "Content",
      "item": [
        {
          "name": "Get Cities",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cities"
          }
        },
        {
          "name": "Get Event Types",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/event-types"
          }
        },
        {
          "name": "Get Add-ons",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/addons"
          }
        },
        {
          "name": "Get Banners",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/banners?position=homepage-hero"
          }
        },
        {
          "name": "Get FAQs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/faqs"
          }
        },
        {
          "name": "Get Testimonials",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/testimonials"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/dashboard/stats"
          }
        },
        {
          "name": "All Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/bookings"
          }
        },
        {
          "name": "Export Bookings CSV",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/export/bookings"
          }
        }
      ]
    }
  ]
}